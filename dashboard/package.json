{
  "name": "@studio-moser/harness-testing-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.23.2"
  },
  "scripts": {
    "prebuild": "node 'Validate Results.js'",
    "build": "OBSERVABLE_TELEMETRY_DISABLE=true HARNESS_DASHBOARD_OUTPUT=.dist-staging observable build && node 'scripts/Sync Build.js'",
    "predev": "node 'Validate Results.js'",
    "dev": "OBSERVABLE_TELEMETRY_DISABLE=true observable preview",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@observablehq/framework": "1.13.4",
    "@observablehq/plot": "0.6.17",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  }
}
