{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "protocol_id", "results"],
  "properties": {
    "schema_version": {"const": "1"},
    "plan_id": {"$ref": "#/$defs/digest"},
    "protocol_id": {"$ref": "#/$defs/digest"},
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["packet_id", "status", "conditions", "session_id", "fresh_session", "identity_blind", "duration_seconds", "usage_complete", "model_usage", "dimensions", "would_work_again"],
        "properties": {
          "packet_id": {"type": "string", "pattern": "^collaboration-[a-f0-9]{24}$"},
          "status": {"enum": ["completed", "blocked", "incomplete"]},
          "conditions": {"$ref": "#/$defs/conditions"},
          "session_id": {"type": "string", "minLength": 1},
          "fresh_session": {"const": true},
          "identity_blind": {"const": true},
          "duration_seconds": {"type": ["number", "null"], "minimum": 0},
          "usage_complete": {"type": "boolean"},
          "model_usage": {"type": "array", "items": {"$ref": "#/$defs/usage"}},
          "dimensions": {"type": "array", "items": {"$ref": "#/$defs/dimension"}},
          "would_work_again": {"type": ["boolean", "null"]}
        }
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "usage": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "model", "input_tokens", "cache_read_tokens", "cache_write_tokens", "output_tokens"],
      "properties": {
        "provider": {"type": "string", "minLength": 1}, "model": {"type": "string", "minLength": 1},
        "input_tokens": {"type": ["integer", "null"], "minimum": 0}, "cache_read_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cache_write_tokens": {"type": ["integer", "null"], "minimum": 0}, "output_tokens": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "dimension": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "score", "rationale"],
      "properties": {
        "name": {"$ref": "#/$defs/dimensionName"},
        "score": {"type": "integer", "minimum": 1, "maximum": 5},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "dimensionName": {"enum": ["directness", "proportionality", "progress_usefulness", "autonomy", "candor", "warmth", "restraint", "completion_clarity"]},
    "conditions": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "model", "effort", "executor", "runtime_version"],
      "properties": {
        "provider": {"type": "string", "minLength": 1}, "model": {"type": "string", "minLength": 1},
        "effort": {"type": "string", "minLength": 1}, "executor": {"type": "string", "minLength": 1},
        "runtime_version": {"type": "string", "minLength": 1}
      }
    }
  }
}
