{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "interaction_limit",
    "facts",
    "rules"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "interaction_limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "facts": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "pattern",
          "fact"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "clarification",
              "approval"
            ]
          },
          "pattern": {
            "type": "string"
          },
          "fact": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
