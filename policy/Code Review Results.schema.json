{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "protocol_id",
    "recorded_at",
    "conditions",
    "packets"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "protocol_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "conditions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "effort",
        "executor",
        "runtime_version"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "effort": {
          "type": "string",
          "minLength": 1
        },
        "executor": {
          "type": "string",
          "minLength": 1
        },
        "runtime_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "packets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "packet_id",
          "target_digest",
          "conditions",
          "status",
          "session_id",
          "fresh_session",
          "no_tested_harness",
          "usage_complete",
          "model_usage",
          "findings",
          "internal_review"
        ],
        "properties": {
          "packet_id": {
            "type": "string",
            "pattern": "^review-[a-f0-9]{24}$"
          },
          "target_digest": {
            "$ref": "#/$defs/digest"
          },
          "conditions": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "provider",
              "model",
              "effort",
              "executor",
              "runtime_version"
            ],
            "properties": {
              "provider": {
                "type": "string",
                "minLength": 1
              },
              "model": {
                "type": "string",
                "minLength": 1
              },
              "effort": {
                "type": "string",
                "minLength": 1
              },
              "executor": {
                "type": "string",
                "minLength": 1
              },
              "runtime_version": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "status": {
            "enum": [
              "completed",
              "blocked",
              "incomplete"
            ]
          },
          "session_id": {
            "type": "string",
            "minLength": 1
          },
          "fresh_session": {
            "const": true
          },
          "no_tested_harness": {
            "const": true
          },
          "usage_complete": {
            "type": "boolean"
          },
          "duration_seconds": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "model_usage": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/usage"
            }
          },
          "findings": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/finding"
            }
          },
          "internal_review": {
            "$ref": "#/$defs/internalReview"
          },
          "confirmation_usage": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/confirmationUsage"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "input_tokens",
        "output_tokens",
        "cache_read_tokens",
        "cache_write_tokens"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cache_read_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cache_write_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "severity",
        "category",
        "title",
        "file",
        "line",
        "status",
        "confirmation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3"
          ]
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "file": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "confirmed",
            "unconfirmed",
            "dismissed"
          ]
        },
        "confirmation": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "internalReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "unknown",
            "recorded"
          ]
        },
        "found": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "fixed": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "unresolved": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "evidence": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "confirmationUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "target_digest",
        "conditions",
        "fresh_session",
        "no_tested_harness",
        "usage_complete",
        "duration_seconds",
        "model_usage"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "target_digest": {
          "$ref": "#/$defs/digest"
        },
        "conditions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "model",
            "effort",
            "executor",
            "runtime_version"
          ],
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "effort": {
              "type": "string",
              "minLength": 1
            },
            "executor": {
              "type": "string",
              "minLength": 1
            },
            "runtime_version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "fresh_session": {
          "const": true
        },
        "no_tested_harness": {
          "const": true
        },
        "usage_complete": {
          "type": "boolean"
        },
        "duration_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "model_usage": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/usage"
          }
        }
      }
    }
  }
}
