{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "rubric_version", "grader", "instruction", "dimensions", "time_budget_seconds"],
  "properties": {
    "schema_version": {"const": "1"},
    "rubric_version": {"type": "string", "minLength": 1},
    "grader": {"$ref": "#/$defs/conditions"},
    "instruction": {"type": "string", "minLength": 1},
    "dimensions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/dimensionName"}},
    "time_budget_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}
  },
  "$defs": {
    "dimensionName": {"enum": ["directness", "proportionality", "progress_usefulness", "autonomy", "candor", "warmth", "restraint", "completion_clarity"]},
    "conditions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "effort", "executor", "runtime_version"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "effort": {"type": "string", "minLength": 1},
        "executor": {"type": "string", "minLength": 1},
        "runtime_version": {"type": "string", "minLength": 1}
      }
    }
  }
}
