{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "labels"],
  "properties": {
    "schema_version": {"const": "1"},
    "plan_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "labels": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["pair_id", "preferred", "annoyance_reason"],
        "properties": {
          "pair_id": {"type": "string", "pattern": "^pair-[a-f0-9]{24}$"},
          "preferred": {"enum": ["A", "B"]},
          "annoyance_reason": {"type": ["string", "null"], "maxLength": 500}
        }
      }
    }
  }
}
